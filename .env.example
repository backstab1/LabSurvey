# Скопируйте в .env и заполните
PORT=3000
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Необязательно: секрет сессий (иначе генерируется в data/.session-secret)
SESSION_SECRET=
# Часовой пояс дат в выгрузках
EXPORT_TIMEZONE=Europe/Moscow
# Google Sheets: путь к JSON-ключу сервисного аккаунта
GOOGLE_APPLICATION_CREDENTIALS=
# За nginx: брать IP из X-Forwarded-For
TRUST_PROXY=0
# Без HTTPS (доступ по IP) — 0, иначе вход в админку не сохранится
COOKIE_SECURE=1
NODE_ENV=production
